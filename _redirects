# Repo files that are not part of the site. Listed first so they win.
/scripts/*        /404.html  404!
/partials/*       /404.html  404!
/data/*           /404.html  404!
/README.md        /404.html  404!
/package.json     /404.html  404!
/LICENSE          /404.html  404!
/netlify.toml     /404.html  404!
/.gitattributes   /404.html  404!
/.gitignore       /404.html  404!

# One URL per page. The .html copies go to the extensionless canonical URL.
# privacy-virtual-background.html stays as it is, the Chrome Web Store links to it.
/index.html         /              301!
/about.html         /about         301!
/said.html          /said          301!
/shipped.html       /shipped       301!
/workflow-log.html  /workflow-log  301!

# The contact page moved into the homepage, as its last section.
/contact.html       /#contact      301!
/contact            /#contact      301!

# the old storefront subdomain and paths go to the contact section
https://workflows.cosmik.work/*   https://cosmik.work/#contact   301!
/workflows/*   /#contact   301!
/workflows     /#contact   301!

# Retired cosmik.work paths
/systems                     /         301
/systems.html                /         301
/framework                   /         301
/framework.html              /         301
/tools/process-mapper.html   /shipped  301
/tools/process-mapper        /shipped  301

# Explicit rewrites so canonical/OG URLs (extensionless) always resolve,
# instead of relying on Netlify's implicit pretty-URL behavior.
/shipped      /shipped.html      200
/workflow-log /workflow-log.html 200
/growth-log   /workflow-log   301
/said         /said.html         200
